# Render Frontend Environment Template
# Set these in the Render Dashboard under your Frontend Static Site "Environment" tab:

# 1. Base URL of your deployed backend service (e.g. https://codecollab-api.onrender.com)
VITE_API_URL=https://your-backend-service.onrender.com

# 2. WebSocket URL for Socket.IO real-time collaboration (typically identical to VITE_API_URL)
VITE_SOCKET_URL=https://your-backend-service.onrender.com

# 3. Public domain of your frontend (e.g. https://codecollab.onrender.com) for generating invite links
VITE_PUBLIC_URL=https://your-frontend-site.onrender.com
