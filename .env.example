# =============================================================
# REAL-TIME COLLABORATIVE CODE EDITOR — ENVIRONMENT VARIABLES
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================

# -----------------------------------------------
# SERVER
# -----------------------------------------------
# The port the backend Express server listens on
PORT=4000

# Environment: development | production | test
NODE_ENV=development

# -----------------------------------------------
# FRONTEND URL
# -----------------------------------------------
# Used for CORS and OAuth redirect URLs
# Local development default:
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------
# DATABASE — PostgreSQL
# -----------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# When running via Docker Compose, use the service name as HOST
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collab_editor

# -----------------------------------------------
# REDIS
# -----------------------------------------------
# Used for Socket.IO cross-instance communication (Pub/Sub)
# When running via Docker Compose, use the service name as HOST
REDIS_URL=redis://localhost:6379

# -----------------------------------------------
# JWT — JSON Web Token
# -----------------------------------------------
# Secret key used to sign and verify authentication tokens.
# Generate a strong random value: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# -----------------------------------------------
# GITHUB OAUTH 2.0
# -----------------------------------------------
# How to get these:
# 1. Go to https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Set Homepage URL: http://localhost:5173
# 4. Set Authorization callback URL: http://localhost:4000/auth/github/callback
# 5. Copy the Client ID and generate a Client Secret
GITHUB_CLIENT_ID=REPLACE_WITH_YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_YOUR_GITHUB_CLIENT_SECRET
# This must match EXACTLY what you set in the GitHub OAuth App settings
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# -----------------------------------------------
# JUDGE0 — Code Execution API
# -----------------------------------------------
# How to get these:
# 1. Go to https://rapidapi.com/judge0-official/api/judge0-ce/
# 2. Create a free account and subscribe to the Basic (free) plan
# 3. Copy your RapidAPI Key
# OR self-host Judge0: https://github.com/judge0/judge0
#
# Leave blank to use MOCK mode (returns fake output — labelled clearly in UI)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=REPLACE_WITH_YOUR_RAPIDAPI_KEY
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# -----------------------------------------------
# COOKIE / SESSION
# -----------------------------------------------
# Secret used to sign cookies
COOKIE_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# Set to 'true' in production (requires HTTPS)
COOKIE_SECURE=false

# -----------------------------------------------
# CORS
# -----------------------------------------------
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# -----------------------------------------------
# SNAPSHOT INTERVAL
# -----------------------------------------------
# How often (in milliseconds) to auto-save code snapshots
# Default: 30000 (30 seconds)
SNAPSHOT_INTERVAL_MS=30000
