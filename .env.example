# =============================================================
# REAL-TIME COLLABORATIVE CODE EDITOR — ENVIRONMENT VARIABLES
# =============================================================
# Copy this file to .env (or backend/.env) and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================

# -----------------------------------------------
# SERVER
# -----------------------------------------------
# The port the backend Express server listens on (Render automatically supplies PORT)
PORT=4000

# Environment: development | production | test
NODE_ENV=development

# -----------------------------------------------
# FRONTEND URL
# -----------------------------------------------
# Used for CORS, cookies, and OAuth redirect URLs
# Production on Render: https://your-app-frontend.onrender.com
# Local development default:
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------
# DATABASE — PostgreSQL
# -----------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# On Render: Use the "External Database URL" or "Internal Database URL"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collab_editor

# -----------------------------------------------
# REDIS (Optional for single instance; required for multi-instance pub/sub)
# -----------------------------------------------
# If blank or unreachable, server seamlessly operates in single-instance mode.
REDIS_URL=redis://localhost:6379

# -----------------------------------------------
# JWT — JSON Web Token
# -----------------------------------------------
# Secret key used to sign and verify authentication tokens.
# Generate a strong random key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# -----------------------------------------------
# GITHUB OAUTH 2.0 (Optional)
# -----------------------------------------------
# 1. Go to https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Set Homepage URL: https://your-frontend.onrender.com
# 4. Set Authorization callback URL: https://your-backend.onrender.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# -----------------------------------------------
# JUDGE0 — Code Execution API
# -----------------------------------------------
# Option 1 (Public Community Instance - Free):
# JUDGE0_API_URL=https://ce.judge0.com
# JUDGE0_API_KEY=
# JUDGE0_API_HOST=
#
# Option 2 (RapidAPI Judge0 CE - Freemium / Paid key):
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key_here
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
#
# Option 3 (Self-Hosted):
# JUDGE0_API_URL=https://your-judge0-instance.com
# JUDGE0_API_KEY=your_optional_auth_token
# JUDGE0_API_HOST=
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# -----------------------------------------------
# COOKIE / SESSION
# -----------------------------------------------
COOKIE_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
# Set to 'true' in production (requires HTTPS)
COOKIE_SECURE=false

# -----------------------------------------------
# CORS
# -----------------------------------------------
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# -----------------------------------------------
# SNAPSHOT INTERVAL
# -----------------------------------------------
# How often (in milliseconds) to auto-save code snapshots to PostgreSQL
SNAPSHOT_INTERVAL_MS=30000

# =============================================================
# FRONTEND ENVIRONMENT VARIABLES (Vite)
# =============================================================
# In frontend/.env.production or Render Static Site environment:
#
# VITE_API_URL=https://your-backend.onrender.com
# VITE_SOCKET_URL=https://your-backend.onrender.com
# VITE_PUBLIC_URL=https://your-frontend.onrender.com
